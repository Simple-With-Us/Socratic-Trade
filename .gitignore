# Root-level one-off local debugging artifacts from manual browser/SQL probes.
/screenshot*.png
/artifacts/
/test-run.ts
/test-ui.cjs
/test-ui.js
/SELECT value FROM store WHERE key = *

# macOS / iCloud Drive conflict copies — this repo lives under ~/Documents, which
# is iCloud-synced; sync conflicts spawn duplicate files named "<name> 2.<ext>"
# (or " 3", " 4"...). They are stale snapshots, not real source. Ignore them so
# they never clutter `git status` or get swept into a commit via `git add -A`.
* [0-9].ts
* [0-9].tsx
* [0-9].md
* [0-9].js
* [0-9].json
* [0-9].css

# GCP service account key — must never be committed.
gcp-sa-key.json

# Agent decision-note scratch written to the repo root — not app code; keep out of git.
/memory/

# GCP service-account key for Secret Manager — a credential, never commit it.
gcp-sa-key.json

# Editor / IDE workspace + scratch files — local only.
.kiro/
*.code-workspace

# design-sync (claude.ai/design system sync) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
