.DS_Store
.air/
# .claude/ stays git-ignored (per-agent/per-machine local settings & session hooks -- see
# scripts/setup-slack-sync.sh), EXCEPT .claude/skills/: those are tracked, Claude-only
# fleet-procedure skills meant to be shared across seats. Cross-agent rules still live in
# AGENTS.md; skills here are Claude Code-specific procedure shortcuts.
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/hooks/**
!.claude/settings.json
.agents/
.tools/
# Secrets come from Infisical (see docs/secrets.md). .env / .env*.local are NEVER a secret
# source and must never be committed, in any directory.
.env
.env*.local
**/.env.local
.next/
node_modules/
.npm-cache/
data/
*.db
*.db-shm
*.db-wal
*.tsbuildinfo
playwright-report/
test/e2e/.playwright-admin-auth-secret.local
test-results/
.env.sentry-build-plugin
.litestream/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# ad-hoc lint/debug capture files agents keep accidentally committing
error.log
lint-output.txt
lint-results.*
lint_results.*
eslint-report.json
eslint_test_results.json
scratch/
.git_diff.txt
did.bin

# Root-level one-off local debugging artifacts from manual browser/SQL probes.
/screenshot*.png
/artifacts/
/test-run.ts
/test-ui.cjs
/test-ui.js
/SELECT value FROM store WHERE key = *

# macOS / iCloud Drive conflict copies — this repo lives under ~/Documents, which
# is iCloud-synced; sync conflicts spawn duplicate files named "<name> 2.<ext>"
# (or " 3", " 4"...). They are stale snapshots, not real source. Ignore them so
# they never clutter `git status` or get swept into a commit via `git add -A`.
* [0-9].ts
* [0-9].tsx
* [0-9].md
* [0-9].js
* [0-9].json
* [0-9].css

# GCP service account key — must never be committed.
gcp-sa-key.json

# Agent decision-note scratch written to the repo root — not app code; keep out of git.
/memory/

# GCP service-account key for Secret Manager — a credential, never commit it.
gcp-sa-key.json

# Editor / IDE workspace + scratch files — local only.
.kiro/
*.code-workspace

# design-sync (claude.ai/design system sync) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# LLM benchmark run artifacts (scripts/benchmark-llm-models.ts default output when --out is omitted)
/llm-benchmark-*.json
/llm-benchmark-*.md

# Lint / verify run artifacts (generated by eslint / the verify gate — machine-specific paths, never tracked)
/error.log
/lint-output.txt
/lint-results.txt
/lint-results.json
/lint_results.json
/eslint-report.json
/eslint_test_results.json

# Xcode / iOS user data & derived data
xcuserdata/
*.xcuserdata
.build/
DerivedData/
.worktrees/

# Apple private keys (App Store Connect API keys, APNs auth keys). These live in Infisical
# (`fleet-secrets get`) ONLY. A .p8 dropped in the repo root is untracked but NOT ignored without this rule, so a
# single `git add -A` would stage a credential that signs pushes for every app in the team —
# which is exactly what was found here on 2026-08-13. One APNs key is team-wide, so leaking it
# is not scoped to one app.
*.p8

# Python generated bytecode
__pycache__/
*.pyc
