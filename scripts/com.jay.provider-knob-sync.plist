<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE launchd job for scripts/sync-provider-knobs.sh (NOT installed by default).

  Runs the provider-knob sync every 30 minutes with --apply, so the trading app's
  Infisical prod knobs stay in sync with the plans tracked in the API-Usage-Monitor.

  INSTALL (owner action; see docs/rollouts/2026-07-10-provider-knob-sync.md):
    1. Edit the paths below if this repo does not live at /Users/jay/Code/Socratic.Trade.
       SSH target is launchd-inherited from the script: Host coolify (Hetzner).
    2. To enable the #agent-sync post-on-change, add your SLACK_BOT_TOKEN to
       EnvironmentVariables (otherwise slack-sync.sh is a safe no-op).
    3. cp scripts/com.jay.provider-knob-sync.plist ~/Library/LaunchAgents/
       launchctl load  -w ~/Library/LaunchAgents/com.jay.provider-knob-sync.plist
    4. Dry-run first WITHOUT --apply to confirm the diff before trusting the writer:
       bash scripts/sync-provider-knobs.sh

  UNINSTALL:
    launchctl unload -w ~/Library/LaunchAgents/com.jay.provider-knob-sync.plist
    rm ~/Library/LaunchAgents/com.jay.provider-knob-sync.plist

  The job is safe to leave running: monitor-unreachable or in-sync runs exit 0
  and write nothing; it only ever writes the allow-listed provider knobs.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jay.provider-knob-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jay/Code/Socratic.Trade/scripts/sync-provider-knobs.sh</string>
    <string>--apply</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jay/Code/Socratic.Trade</string>

  <!-- launchd starts with a bare PATH; node/ssh/curl must be reachable. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>SLACK_TOPIC</key>
    <string>Socratic.Trade</string>
    <!-- Add SLACK_BOT_TOKEN here to enable the #agent-sync post-on-change:
    <key>SLACK_BOT_TOKEN</key>
    <string>xoxb-...</string>
    -->
  </dict>

  <!-- Every 30 minutes. Does NOT run at load (avoid a surprise write on install). -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/jay/Library/Logs/provider-knob-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jay/Library/Logs/provider-knob-sync.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
