# Host env for st-litestream-restore-drill (installed as /etc/default/st-litestream-restore-drill, mode 0600).
# Populate from an Infisical service token on the host (operator).  Never commit real secrets.
# Do not use universal-auth machine identities for this file.

ST_RESTORE_DRILL_NOTIFY=1
ST_RESTORE_DRILL_TIMEOUT_SECONDS=21600
ST_RESTORE_DRILL_STATE_DIR=/var/lib/st-ops
ST_RESTORE_DRILL_STATUS_JSON=/var/lib/st-ops/litestream-restore-drill-status.json

LIVE_DB=/app/data/app.db
LITESTREAM_CONFIG=/app/litestream.coolify.yml

# Backblaze B2 (Litestream replication tier)
AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: same GitHub Actions secret as st-container-restart-monitor (not Infisical by default)
# SENTRY_FLEET_DSN=
