# Host env for st-litestream-restore-drill (installed as /etc/default/st-litestream-restore-drill, mode 0600).
# Non-secret config only.  Never put AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# SENTRY_FLEET_DSN, or an Infisical token in this file.  Under systemd,
# EnvironmentFile is the process environment and always wins over a shell export.
#
# B2 credentials and the optional Sentry DSN come from Infisical at run time,
# using a service token file (Jay: service tokens only — never machine identities
# or universal auth).  Confirm every project id, path, and secret name on the
# host before the first run; the defaults below are documented starting points,
# not proof that those secrets already exist at that path.

ST_RESTORE_DRILL_NOTIFY=1
ST_RESTORE_DRILL_TIMEOUT_SECONDS=21600
ST_RESTORE_DRILL_STATE_DIR=/var/lib/st-ops
ST_RESTORE_DRILL_STATUS_JSON=/var/lib/st-ops/litestream-restore-drill-status.json

LIVE_DB=/app/data/app.db
LITESTREAM_CONFIG=/app/litestream.coolify.yml

# Non-secret B2 replica config (bucket / endpoint / region are not credentials).
AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT=
AWS_REGION=

# Infisical service token: a mode-0600 file that contains only the token.
# Suggested path (create on the host; this wrapper never writes the token):
INFISICAL_TOKEN_FILE=/etc/default/st-litestream-restore-drill.infisical-token

# Documented defaults; confirm on the host.  This repo does not assume the
# secrets already live at this path.  INFISICAL_PROJECT_ID is always required:
# supply it at install time (this repo does not ship one).
INFISICAL_DOMAIN=https://app.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=/

# Secret names inside that project/env/path (defaults equal the env var names).
# Confirm these names exist before the first scheduled run.
INFISICAL_SECRET_AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
INFISICAL_SECRET_AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
# Optional; when unset after Infisical lookup, the drill stays silent instead of alerting.
INFISICAL_SECRET_SENTRY_FLEET_DSN=SENTRY_FLEET_DSN
