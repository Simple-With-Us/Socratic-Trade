[Unit]
Description=Litestream L1 boundary trim (fleet, sequential)
Documentation=https://github.com/Simple-With-Us/Socratic-Trade/blob/main/docs/litestream.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
# Repo source of truth.  Host copy is installed next to this unit.
ExecStart=/usr/local/sbin/litestream-l1-boundary-trim-fleet
SyslogIdentifier=litestream-l1-trim
