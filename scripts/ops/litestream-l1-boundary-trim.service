[Unit]
Description=Litestream L1 boundary trim (fleet, sequential)
Documentation=https://github.com/Simple-With-Us/Socratic-Trade/blob/main/docs/litestream.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
EnvironmentFile=-/etc/default/st-host-cron-sentry
# Repo source of truth.  Host copies install next to these units.
ExecStart=/usr/local/sbin/sentry-cron-checkin.py wrap --monitor-slug st-host-litestream-l1-boundary-trim --schedule "4 0 * * *" --checkin-margin 120 --max-runtime 180 -- /usr/local/sbin/litestream-l1-boundary-trim-fleet
SyslogIdentifier=litestream-l1-trim
