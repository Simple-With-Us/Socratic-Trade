[Unit]
Description=Socratic-Trade weekly Litestream B2 restore drill (oneshot)
Documentation=https://github.com/Simple-With-Us/Socratic-Trade/blob/main/docs/runbooks/st-litestream-restore-drill.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
EnvironmentFile=-/etc/default/st-litestream-restore-drill
ExecStart=/usr/local/sbin/st-litestream-restore-drill.sh
SyslogIdentifier=st-litestream-restore-drill
# 30 min above the wrapper default (ST_RESTORE_DRILL_TIMEOUT_SECONDS=21600) so the wrapper's own
# timeout fires first, writes the failure status, alerts, and cleans scratch.  Raise both together.
TimeoutStartSec=23400
