# Host env for st-container-restart-monitor (installed as /etc/default/st-container-restart-monitor).
# Copy values from the same fleet secret store used for SENTRY_FLEET_DSN / Pushover on the box.
# Do not commit real tokens to git.

ST_RESTART_MONITOR_NOTIFY=1
ST_RESTART_MONITOR_COOLIFY_ID=d83b1aykr03uwr32yhgzaiay
ST_RESTART_MONITOR_WINDOW_SECONDS=900
ST_RESTART_MONITOR_DELTA_THRESHOLD=3
ST_RESTART_MONITOR_ALERT_COOLDOWN_SECONDS=3600

# Pushover (INFISICAL.md names; ST subject token preferred)
# PUSHOVER_ST_API_TOKEN=
# PUSHOVER_APP_TOKEN=
# PUSHOVER_USER_KEY=

# Optional fleet-infra Sentry (PagerDuty route via Sentry; same as scripts/sentry-ci-report.yml)
# SENTRY_FLEET_DSN=
