# Host env for st-container-restart-monitor (installed as /etc/default/st-container-restart-monitor).
# Do not commit real tokens. An unset channel is silent: the monitor logs the skip and does
# not arm the alert cooldown, so a later configured channel can still page.
#
# PUSHOVER_ST_API_TOKEN and PUSHOVER_APP_TOKEN are Infisical keys (INFISICAL.md).
# PUSHOVER_USER_KEY is not in Infisical. Copy it from the Pushover dashboard.
# SENTRY_FLEET_DSN is the GitHub Actions repo secret secrets.SENTRY_FLEET_DSN
# (.github/workflows/sentry-ci-report.yml), not an Infisical or host default.
# Export it on the host or the Sentry channel stays skipped.

ST_RESTART_MONITOR_NOTIFY=1
# Coolify application UUID. Required. Set on the host; do not commit a shared default.
ST_RESTART_MONITOR_COOLIFY_ID=
ST_RESTART_MONITOR_WINDOW_SECONDS=900
ST_RESTART_MONITOR_DELTA_THRESHOLD=3
ST_RESTART_MONITOR_ALERT_COOLDOWN_SECONDS=3600

# PUSHOVER_ST_API_TOKEN=
# PUSHOVER_APP_TOKEN=
# PUSHOVER_USER_KEY=

# SENTRY_FLEET_DSN=
