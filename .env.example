# Multi-user key model: env keys here belong to the PRIMARY (`local`) user. At server boot the
# per-user-only env keys below (OpenAI/Anthropic + ALPACA_PAPER_* + ROBINHOOD_MCP_AUTH_TOKEN) are
# migrated into the `local` user's per-user store, so there is no special `local` env branch — every
# user (incl. you) resolves broker/LLM keys from their own stored keys / OAuth.
#   - LLM: a user's own key wins; while LLM_OPERATOR_FALLBACK=on, the operator key serves any user
#     WITHOUT their own key as a failover. Per-user spend is tracked (GET /api/admin/llm-usage).
#     Set LLM_OPERATOR_FALLBACK=off to make everyone (incl. local) require their own key.
#   - Market-data / RAG / macro env keys (Finnhub, Massive, FRED, Pinecone, Voyage, Apify, …) remain
#     a SHARED global fallback for all users — operator-funded public data; a user's own market-data
#     key still overrides and joins the consent pool.
OPENAI_API_KEY=
# Fallback model only. Each user picks their model + reasoning effort in Settings (per-user policy),
# which OVERRIDES this. gpt-5/o-series are reasoning models (no temperature; uses reasoning_effort).
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_URL=
# xAI / Grok (OpenAI-compatible). Optional — only needed to use a grok-* model.
# Operator-funded fallback key (per-user keys are added in Settings → API keys):
XAI_API_KEY=
# Override the xAI base URL if needed (default https://api.x.ai/v1/chat/completions):
XAI_API_URL=
# Anthropic / Claude — used by the Assistant chat (claude-* models) and the optional cross-provider
# Red Team Bear. Optional operator-funded backup; a user's own key in Settings → API keys wins.
ANTHROPIC_API_KEY=
# Google Gemini (OpenAI-compatible). Optional — only needed to use a gemini-* model.
GEMINI_API_KEY=
# Override the Gemini base URL if needed (default
# https://generativelanguage.googleapis.com/v1beta/openai/chat/completions):
GEMINI_API_URL=
# Mistral (OpenAI-compatible). Optional — only needed to use a mistral-* model.
MISTRAL_API_KEY=
# Override the Mistral base URL if needed (default https://api.mistral.ai/v1/chat/completions):
MISTRAL_API_URL=
# DeepSeek (OpenAI-compatible). Optional — only needed to use a deepseek-* model.
DEEPSEEK_API_KEY=
# Override the DeepSeek base URL if needed (default https://api.deepseek.com/v1/chat/completions):
DEEPSEEK_API_URL=
# All six LLM provider keys above are operator-funded BACKUPS. Resolution is per-user-first: a user's
# own key (Settings → API keys) always wins; the env key only serves users without one (failover
# gated by LLM_OPERATOR_FALLBACK).
LLM_OPERATOR_FALLBACK=on

# Per-LLM-provider failure cooldown for the Green/Red failover chains (handoff 6b.4, see
# src/lib/llm-provider-cooldown.ts). Advisory/observable only — a cooling chain is still attempted
# (least-recently-failed first) once every lane is cooling, so this can never make a run worse than
# no-cooldown behavior. Kill switch: set to 1/true/on/yes to restore exact pre-cooldown behavior.
LLM_PROVIDER_COOLDOWN_DISABLED=
# Cooldown TTL (ms) for a transient rate-limit 429. Default 300000 (5 min).
LLM_PROVIDER_COOLDOWN_TRANSIENT_MS=
# Cooldown TTL (ms) for a hard billing/insufficient_quota failure. Default 3600000 (60 min).
LLM_PROVIDER_COOLDOWN_BILLING_MS=
# RED_TEAM_LLM_PROVIDER / RED_TEAM_LLM_MODEL were RETIRED 2026-07-07 (single-adversary
# consolidation): the Red Team reviewer's model comes ONLY from Settings → LLM models
# (per-account redTeamLlmModel; no env override, no default, no fallback to the Green model).
# A deployment that still has them set at first boot after upgrading gets its blank per-account
# Red models seeded ONCE from the old override (db migration v15) so the safety setup keeps
# working — then these vars are dead and can be removed.
# "mock"/unset leaves Robinhood disconnected; "mcp" enables the real MCP path.
ROBINHOOD_ADAPTER=mock
DATABASE_URL=file:./data/app.db

# ── Secrets source of truth ───────────────────────────────────────────────────
# RECOMMENDED for prod: store every secret in Infisical Cloud (free tier) and launch via
# `npm run start:secrets`, which pulls them at startup. Then this file holds only the BOOTSTRAP
# below (the Infisical connection) — never the actual API keys. See docs/secrets.md.
#
# Bootstrap (the only secrets-related values that stay local). Authenticate the box's Infisical
# machine identity with its **Client ID + Client Secret** (universal auth — long-lived); the runner
# exchanges them for a short-lived access token automatically, so nothing expires. IMPORTANT: the
# Client Secret is NOT the access token — do NOT paste a 64-char Client Secret into INFISICAL_TOKEN
# (that yields a "malformed token" 403). App secrets live in the `Socratic.Trade` project
# (slug `socratic-trade`); shared App-A/B (congress-trade) secrets live in `shared-at-ct`
# (18f563a3-…).
# Local bootstrap resolution is process env > .env.local > ~/.secrets/global-api-keys. The global
# file accepts only INFIISICAL_ST_* (the owner's existing spelling) or INFISICAL_ST_* for this app,
# plus INFISICAL_CT_SHARED_* for shared; generic names remain valid only in process env/.env.local.
# An ambient GLOBAL_API_KEYS_FILE override is ignored. Aliases are normalized in memory only; values
# are never copied/printed. A half-pair fails before any Infisical call. The global file must be a
# current-user-owned regular non-symlink with no group/other permissions (normally chmod 600).
INFISICAL_PROJECT_ID=39d93bb7-76f9-498c-8b50-a7def52e072f
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# …or supply a pre-minted access token instead of the Client ID/Secret pair. NOT recommended — it
# expires (see the identity's Access Token TTL); prefer the pair above so the runner re-mints.
INFISICAL_TOKEN=
INFISICAL_ENV=prod
INFISICAL_PATH=/
# Optional for EU Cloud or self-hosted Infisical. The runner passes it only to CLI helpers and masks
# it from the app (default CLI domain is the US Cloud endpoint).
INFISICAL_DOMAIN=
INFISICAL_WATCH=false
# Watch mode gives the third-party CLI only a minimal runtime environment. Put all credentials needed
# by a watched app in Infisical; unrelated shell/provider credentials are deliberately not inherited.
# For preload safety, watch discards an Infisical-injected NODE_OPTIONS and restores only the host
# NODE_OPTIONS after bootstrap names are masked. Normal non-watch export mode preserves manager wins.
# Optional shared project (App-A/B / congress-trade secrets). Setting INFISICAL_SHARED_PROJECT_ID
# makes the runner pull BOTH projects and merge them with the APP project winning any overlapping
# key; give the shared project its OWN machine identity (its own Client ID + Secret). Leave blank
# for single-project. When a shared identity is available and this is blank, the runner safely
# defaults shared-at-ct = 18f563a3-9c88-454c-96eb-28fc9678f3ba.
INFISICAL_SHARED_PROJECT_ID=
INFISICAL_SHARED_CLIENT_ID=
INFISICAL_SHARED_CLIENT_SECRET=
INFISICAL_SHARED_TOKEN=

# Optional primary-account bridge writer for API Usage Monitor. DEFAULT OFF.
# This app always reads only the fixed primary user (`local`) and exports only
# that user's stored Gemini + DeepSeek API keys to the fixed Socratic.Trade
# project / prod /usage-monitor/st-primary/v1 path. Project, path, environment,
# provider list, and user are not configurable. Use a dedicated project-managed
# identity with no-access membership plus exact-path read/readValue/create/edit
# privileges; do not grant delete. The Usage Monitor reader uses another,
# read-only identity. See docs/secrets.md.
INFISICAL_ST_PRIMARY_WRITER_ENABLED=false
INFISICAL_ST_PRIMARY_WRITER_CLIENT_ID=
INFISICAL_ST_PRIMARY_WRITER_CLIENT_SECRET=
#
# Enforcement: when set, the app REFUSES TO BOOT unless launched through the secrets-manager runner
# (start:secrets). This prevents a credential from silently being served out of a local .env.local.
# SECRETS_SOURCE is set automatically by the runner — do NOT set it by hand. Leave
# REQUIRE_SECRETS_MANAGER unset for local dev / tests.
REQUIRE_SECRETS_MANAGER=

# Master key for AES-256-GCM encryption of per-user API keys stored in the DB
# (user_api_keys table). MUST be a stable 32-byte hex string (64 hex chars), and MUST be
# set for any persistent/multi-user deployment: if unset, a RANDOM key is generated per
# process, so every previously-stored key becomes undecryptable after a restart.
# Generate one with:  openssl rand -hex 32
ENCRYPTION_KEY=
MARKET_SCAN_LIMIT=30
MARKET_SCAN_CACHE_TTL_MS=300000
MARKET_SCAN_EVENT_RESERVE=8
HISTORY_TTL_MS=1800000
MARKET_DATA_PENDING_TTL_MS=1800000
# Shared/env-key OHLC history is cached globally. User-saved keyed history is private
# by default; set on only after confirming data-sharing/entitlement policy.
MARKET_DATA_SHARE_USER_KEYED_HISTORY=off

# Required only when ROBINHOOD_ADAPTER=mcp. URL defaults to Robinhood's official
# Trading MCP endpoint if unset.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_RESOURCE=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_PROTOCOL_VERSION=2025-03-26
ROBINHOOD_MCP_AUTH_TOKEN=

# Optional OAuth flow for hosted Robinhood MCP servers that do not use a static token.
# Visit /api/auth/robinhood/start on desktop to complete consent.
# By default, the app discovers OAuth endpoints from ROBINHOOD_MCP_URL. Set this
# to off only for a provider that requires manual endpoint configuration.
ROBINHOOD_MCP_OAUTH_DISCOVERY=
ROBINHOOD_MCP_AUTHORIZATION_URL=
ROBINHOOD_MCP_TOKEN_URL=
# When set, dynamic registration wins over any static client id so the callback
# origin can be registered correctly for the current host.
ROBINHOOD_MCP_CLIENT_REGISTRATION_URL=
ROBINHOOD_MCP_CLIENT_NAME=
ROBINHOOD_MCP_CLIENT_ID=
ROBINHOOD_MCP_CLIENT_SECRET=
# Optional. Leave blank in hosted environments so the app derives the public
# callback from x-forwarded-host/NEXT_PUBLIC_SITE_URL.
ROBINHOOD_MCP_REDIRECT_URI=
# Opt-in same-machine recovery path: when on and ROBINHOOD_MCP_REDIRECT_URI is a
# localhost callback, public-site reconnect starts from the hosted app but asks
# Robinhood to return to localhost. Use only when Robinhood rejects the public
# callback and the browser is on the same machine as the server.
ROBINHOOD_MCP_ALLOW_LOOPBACK_REDIRECT=off
ROBINHOOD_MCP_SCOPES=internal

# Optional broker account credentials. Connected accounts entered in Accounts take
# precedence. Paper accounts are optional and user-selected.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Company logo sources.
# logo.dev publishable token — activates a cascade fallback when the GitHub
# ticker-logos source returns 404. The client detects the app's dark/light mode
# and the proxy forwards it so logos adapt automatically.
# Domain-restricted keys require the app to run at the allowed origin.
# Free tier: 500k req/month; requires attribution for commercial use.
# Get a publishable key at https://logo.dev  (sk_* secret key is for mgmt API only)
LOGO_DEV_TOKEN=
LOGO_DEV_SECRET_KEY=

# Optional market-data / enrichment keys.
FINNHUB_API_KEY=
FMP_API_KEY=
# ROIC.ai fundamentals (shared-operator-infra). Profile endpoint fills company/sector/industry/
# dividend/short-interest; ratios paths may 404 on some plans — cascade still benefits from profile.
ROIC_API_KEY=
# Shared RapidAPI marketplace key for enrichment failover lanes (see src/lib/rapidapi-quota.ts):
# Mboum, YH Finance 15, Alpha Vantage RapidAPI, FMP-RapidAPI, Insiders, TwelveData RapidAPI,
# Real-Time Finance Data, plus scarce failover for delisted yh-finance / seeking-alpha hosts.
# Verified Pricing page (Start Free Plan):
#   https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-finance-data/pricing
RAPIDAPI_KEY=
# FilingAPI.dev (https://filingapi.dev) — X-API-Key. Env name is FILINGAPI (also accepts FILINGAPI_KEY).
FILINGAPI=
# SEC EDGAR XBRL debt/equity enrichment — DEFAULT ON (keyless). Set 0/off to disable.
SEC_XBRL_ENRICHMENT_ENABLED=
# OPTIONAL explicit throttle on symbols enriched per scan (applies to every enrichment provider,
# not just FMP). UNSET (default): the full scan candidate list is enriched — top-N ranked + event
# outliers + every held position, with no cap (owner ruling 2026-07-09). Set a number only for
# quota thrift on free tiers (e.g. free FMP is 250 calls/DAY); the value is honored unclamped.
FMP_MAX_SYMBOLS=
# Opt-in: also fetch FMP price-target-consensus (numeric analyst targets: mean/high/low/median). An
# extra FMP call per symbol and not on every key tier, so default off (targets ride null/"-" when off).
# When on, targets reach the scan quote and flow into the congress-share analyst[] push.
FMP_PRICE_TARGETS_ENABLED=off
# Earnings-call transcript RAG producer. DEFAULT OFF and dual-gated: FMP's paid Starter plan can be
# healthy and under its 300/min + bandwidth limits while these stable endpoints still return HTTP 402;
# FMP currently lists transcripts under Ultimate. Do not enable unless the configured plan exposes
# both endpoints AND the agreement permits transcript persistence/embedding/display. The producer uses
# header auth, meters every actual request, and keeps first-content-observed separate from call date.
WEB_SOURCE_FMP_TRANSCRIPTS=off
FMP_TRANSCRIPT_STORAGE_RIGHTS_CONFIRMED=off
# Independent transcript discovery cadence and retry cadence (not tied to SEC filing refresh).
FMP_TRANSCRIPT_TTL_HOURS=24
FMP_TRANSCRIPT_RETRY_MINUTES=60
# Re-probe one endpoint after a typed endpoint_not_entitled response; the run stops after that first 402.
FMP_TRANSCRIPT_NOT_ENTITLED_RETRY_HOURS=24
# Exact upstream-attempt cap per scheduled run, including retries and both dates/body endpoints.
# Set 0 to pause attempts without changing the feature/rights flags.
FMP_TRANSCRIPT_MAX_REQUESTS_PER_RUN=12
# Newest fiscal periods considered per symbol after one dates lookup.
FMP_TRANSCRIPT_MAX_PER_SYMBOL=2
# Extra attempts after a transient/network/invalid-JSON response (0-3; each attempt is metered).
FMP_TRANSCRIPT_HTTP_RETRIES=1
FMP_TRANSCRIPT_RETRY_DELAY_MS=600
# Hard request deadline and response byte caps; oversized provider JSON is rejected before parsing.
FMP_TRANSCRIPT_TIMEOUT_MS=20000
FMP_TRANSCRIPT_DATES_MAX_RESPONSE_BYTES=1000000
FMP_TRANSCRIPT_BODY_MAX_RESPONSE_BYTES=8000000
# Hard bound for an operator-run rights inventory/purge. Exceeding it aborts without mutation rather
# than returning a partial result that could falsely verify a purge.
FMP_TRANSCRIPT_RIGHTS_SCAN_MAX_RECORDS=250000
# Crash-durable provider admission/outcome authority. This ID scopes rows, but matching IDs alone do
# NOT make separate app databases authoritative together; transcript activation still requires every
# FMP caller to use one genuinely shared transactional store/authority.
PROVIDER_QUOTA_AUTHORITY_ID=socratic-trade-local

# --- EarningsCalls.dev earnings-call transcripts (alternate transcript source; default DORMANT) ---
# Burst-then-smart-daily program (docs/rollouts/2026-07-19-earningscalls-burst-smart-daily.md):
# a 25-transcript burst once, then 5/day with smart candidate selection (holdings > earnings
# recency > scan rank > watchlist > universe-manifest tail). One vendor, two sales channels — set
# EXACTLY ONE key (direct wins if both are set):
#   EARNINGSCALLS_API_KEY       — first-party key (https://earningscalls.dev/api/v1, X-API-Key
#                                 header; paid plans only — no free tier direct).
#   EARNINGSCALLS_RAPIDAPI_KEY  — RapidAPI marketplace key (earnings-call-transcripts1.p.rapidapi.com,
#                                 x-rapidapi-* headers). The FREE 200 requests/month plan lives here;
#                                 this is the owner's channel (subscribed 2026-07-16).
# Either key IS the opt-in: setting it turns on the daily fetch pass AND makes ingested transcripts
# retrievable in RAG/prompts (they never appear on user-facing pages). No key = zero calls, nothing
# constructed. See src/lib/earningscalls-transcripts.ts for the full researched API/budget notes.
#
# CRITICAL — entitlement risk (recon memo finding #2): the free plan may return 250-char transcript
# PREVIEWS instead of full text (unconfirmed as of 2026-07-19). The first pass always runs a
# 2-request entitlement probe (GET /me + one real transcript fetch) before any burst/daily work; if
# it detects a preview, the whole program is durably paused (no permanent stub caching, one
# operator notification, no retry storm) until POST /api/admin/earningscalls clears or re-probes it.
EARNINGSCALLS_API_KEY=
EARNINGSCALLS_RAPIDAPI_KEY=
# Kill-switch: 1/true halts fetching AND retrieval of this source without deleting the key.
EARNINGSCALLS_DISABLED=
# Self-imposed monthly SOFT request ceiling (UTC calendar month, persisted across restarts,
# reserved BEFORE every HTTP call). Default 180: the owner's free plan has a HARD provider-side 200
# requests/month limit, so 20 requests of headroom are kept for manual/diagnostic use and
# accounting drift. 0 blocks all calls without removing the key. Paired with the ROLLING window
# budget below — the tighter of the two always wins (dual-bound reserve-before-call).
EARNINGSCALLS_MONTHLY_BUDGET=180
# Rolling 31-day request budget — the bound that actually maps to the provider's hard 200/month,
# since RapidAPI free-plan windows reset on the SUBSCRIPTION anniversary, not the UTC calendar
# month (a calendar-month counter alone can straddle the provider's real window). Default 195 (5
# under 200, for accounting drift). This REPLACES the old fixed "6 requests/pass" safety invariant:
# a durable per-UTC-day counter, pruned to the trailing 31 days, is checked on every reservation, so
# burst days (up to ~50 requests) and ordinary daily passes (~6) are both provably safe regardless
# of the per-pass request count.
EARNINGSCALLS_ROLLING_WINDOW_BUDGET=195
# A transcript is fetched only when the symbol's latest earnings call happened within this many
# days (ordinary daily pass only — an armed burst bypasses this to reach historical quarters too).
EARNINGSCALLS_RECENT_DAYS=7
# After held symbols, at most this many of the latest scan's top candidates are considered per pass
# (legacy knob — the smart picker's scan-rank tier draws from the same pool).
EARNINGSCALLS_TOP_CANDIDATES=3
# Negative-cache TTL (days): a budget-costing call that found no transcript (or a symbol probe) is
# not repeated for the same key/symbol within this window.
EARNINGSCALLS_NEGATIVE_TTL_DAYS=3
# How many NEW transcripts an ordinary (non-burst) daily pass targets (~6 requests including the
# amortized id-resolution listing call, on a day something reported; 0 on a quiet day).
EARNINGSCALLS_DAILY_TARGET_TRANSCRIPTS=5
# Ceiling on a single one-shot burst arm (POST /api/admin/earningscalls {"action":"burst"} or the
# internal-settings earningscalls_burst_pending counter). The owner's "burst 25 now" ask.
EARNINGSCALLS_BURST_MAX_TRANSCRIPTS=25
# Anti-preview cache/ingest floor (recon memo finding #1): a fetched transcript body shorter than
# this many characters is treated as a plan-restricted preview — never cached as fetched-forever
# content, never ingested, and it trips the durable entitlement block above. Default 1200,
# comfortably above the documented 250-char preview length; the floor cannot be set below 250.
# REPLACES the old bare MIN_TRANSCRIPT_CHARS=100 "is there any text" floor as the real anti-preview
# protection (100 chars alone would have let a 250-char preview through).
EARNINGSCALLS_PREVIEW_GUARD_MIN_CHARS=1200
# Anti-runaway per-pass HTTP request ceiling — NOT the quota-safety mechanism (that's the rolling
# ledger above); this just stops a bug/runaway loop from making an absurd number of calls in one
# process tick. Default 16 (daily); a burst pass computes its own generous ceiling from its target
# transcript count. The override can only LOWER it, never raise it past 70.
EARNINGSCALLS_MAX_REQUESTS_PER_PASS=16
# Anchor symbol used by POST /api/admin/earningscalls {"action":"probe-entitlement"} ONLY when no
# account currently holds any position (nothing else to test against). Default AAPL.
EARNINGSCALLS_ENTITLEMENT_PROBE_ANCHOR=AAPL
# Durable Voyage/Pinecone request windows. Empty/unset uses these defaults; explicit 0 pauses the
# provider lane. Voyage's cost fuse reserves the same estimator used by rag_usage. Pinecone's variable
# cost estimator is currently zero, so its existing RAG RU/WU budgets remain the binding spend fuse.
PROVIDER_DISPATCH_VOYAGE_PER_MIN=60
PROVIDER_DISPATCH_PINECONE_PER_MIN=600
PROVIDER_DISPATCH_VOYAGE_MAX_COST_USD_PER_DAY=25
PROVIDER_DISPATCH_PINECONE_MAX_COST_USD_PER_DAY=25
# FMP request-rate budget (per rolling window and credential; the best-first in-process planner is
# backed by the atomic durable provider-dispatch ledger before each real request). Distinct
# from FMP_MAX_SYMBOLS above (a symbols/scan throttle applied first). Each miss symbol costs 2-5 FMP
# requests (insider + senate always; ratios-ttm/grades-consensus/price-target-consensus when not
# skipped). Defaults with NO env set: 290/min (FMP Starter is 300/min; 290 leaves headroom) and NO
# daily cap. Override the minute cap or opt into a daily cap here:
# PROVIDER_QUOTA_FMP_PER_MIN — default 290; set 0 to remove the minute window entirely.
PROVIDER_QUOTA_FMP_PER_MIN=
# PROVIDER_QUOTA_FMP_PER_DAY — UNSET = no daily cap (default). Set it to add a rolling-day window,
# e.g. 240 if you drop to the free 250/day tier (240 leaves headroom). PROVIDER_QUOTA_FMP_PER_HOUR
# is also honored via the same generic path if ever needed.
PROVIDER_QUOTA_FMP_PER_DAY=
NEWS_CACHE_TTL_MS=21600000
ALPHAVANTAGE_API_KEY=
# Legacy back-compat only: a comma-separated ALPHAVANTAGE_API_KEYS is still read, but only its
# FIRST entry is used — the old multi-key pool (rotate across several free keys to multiply the
# 25/day quota) was retired. Alpha Vantage's daily cap is enforced PER SOURCE IP, not per
# presented apikey=, so extra keys never multiplied real throughput — they only added
# rotation/exhaustion churn on top of the same shared IP budget (see resolveAlphaVantageKeyPool
# in src/lib/db-api-keys.ts). New deployments should just set the singular ALPHAVANTAGE_API_KEY
# above; leave this unset.
ALPHAVANTAGE_API_KEYS=
# Because the 25/day cap is per-IP (not per key — see above), the app self-limits BELOW it
# instead of relying purely on Alpha Vantage's own rejection: PROVIDER_QUOTA_ALPHA_VANTAGE_PER_DAY
# is a proactive daily call ceiling (default 23, 2-call headroom), persisted across restarts (this
# app deploys/redeploys several times a day, so an in-memory counter would forget usage and let
# the day's real total creep past budget). Must be a non-negative integer; 0 proactively blocks
# all Alpha Vantage calls for the rest of today. The reactive per-key exhaustion path (rotate on
# AV's own daily-cap message) stays fully active alongside this as belt-and-suspenders — see
# src/lib/alpha-vantage-key-pool.ts.
PROVIDER_QUOTA_ALPHA_VANTAGE_PER_DAY=23
# Optional overrides for the assumed Alpha Vantage daily-quota reset instant (NOT documented by
# AV — "midnight America/New_York" is the community assumption, not a confirmed fact). Tune
# empirically if a capped key comes back alive earlier/later than expected. Also anchors the
# proactive daily budget's own day-rollover above.
ALPHAVANTAGE_RESET_TZ=America/New_York
ALPHAVANTAGE_RESET_HOUR=0
FINTECH_STUDIOS_API_KEY=
FINTECH_STUDIOS_BASE_URL=
FRED_API_KEY=
# Tradier price history is sourced from your connected Tradier BROKER account (Settings -> Accounts),
# not a separate API key here — connect a Tradier account to enable it as a price-history source too.
MARKETSTACK_API_KEY=
TIINGO_API_KEY=
TWELVEDATA_API_KEY=

# --- RAG / Pinecone / Voyage -------------------------------------------------------
# The app stores BYO dense vectors: Voyage creates 1024-dim finance embeddings; Pinecone stores
# them in a dense/cosine index. Pinecone names must be lowercase, so the Socratic Trade index is
# `socratic-trade` even when the product name is shown as "Socratic-Trade".
PINECONE_INDEX_NAME=socratic-trade
PINECONE_API_KEY=
VOYAGE_API_KEY=
# Free Voyage tier is 3 requests/minute. Paid keys can set delay to 0, but ingestion still remains
# capped by SEC_FILING_RAG_MAX_PER_RUN and RAG_INGEST_MAX_TEXTS_PER_DAY below.
VECTOR_EMBED_BATCH_DELAY_MS=21000
# Alternative embed/rerank providers (bge-m3-metering-gate, 2026-07-18): setting either of these
# activates BAAI/bge-m3 embeddings (via OpenRouter's "baai/bge-m3" or SiliconFlow's "BAAI/bge-m3")
# INSTEAD OF Voyage, for BOTH embed and rerank. Precedence when RAG_EMBED_PROVIDER (below) is
# UNSET: OPENROUTER_API_KEY wins if present, else SILICONFLOW_API_KEY, else Voyage. That means
# setting OPENROUTER_API_KEY for an unrelated feature (e.g. LLM routing) ALSO flips RAG embeddings
# to bge-m3 as a side effect — this is the exact coupling RAG_EMBED_PROVIDER exists to break.
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
# OpenRouter prepaid-credit low-balance signal on /api/health (for an external monitor like
# Uptime Robot). Universal routing makes OpenRouter the single point of failure for all LLM+RAG,
# so /api/health exposes dependencies.openrouter.ok=false + a checks.openrouterCredits detail when
# the remaining balance drops below the threshold. The /credits query is FREE (no LLM tokens) and
# cached. Low balance DEGRADES the probe (never 503s — a restart can't refill credits).
OPENROUTER_LOW_CREDIT_USD=3
# How often the cached balance is refreshed (ms; min 30000). Default 10 min.
OPENROUTER_CREDIT_CHECK_INTERVAL_MS=600000
# Pins RAG embed+rerank provider selection explicitly, decoupling it from mere key presence above.
# Values: "voyage" | "openrouter" | "siliconflow". UNSET (default): behavior is byte-for-byte
# identical to before this flag existed (key-presence precedence, see above) — setting this is
# opt-in only. When SET, a missing/mock key for the pinned provider is a LOUD error at embed time
# (not a silent fallback to a different provider/embedding space) — see activeEmbeddingProvider /
# activeRerankProvider in src/lib/vector-db.ts.
RAG_EMBED_PROVIDER=
VECTOR_EMBED_BATCH_SIZE=8
VECTOR_STORECONTEXTS_DEDUP=on
RAG_PINECONE_WRITE_BUDGET_ENABLED=on
# Daily Pinecone write units budget. Safe backup/default is 200000 (200k).
# Raised to 2000000 (2M) in Infisical during active 1k-stock backfill; shift back to 200k post-backfill.
RAG_PINECONE_MAX_WRITE_UNITS_PER_DAY=200000
RAG_INGEST_BUDGET_ENABLED=on
# Daily text/chunk budget. Safe backup/default is 20000 (20k).
# Raised to 200000 (200k) in Infisical during active 1k-stock backfill; shift back to 20k post-backfill.
RAG_INGEST_MAX_TEXTS_PER_DAY=20000
# Filings ingested per scheduled run. Unset: paid Voyage (delay <= 5000) defaults to 25,
# free tier stays at 1 (a bigger cap stalls the scheduler tick for hours at free embed pace).
# The admin backfill route's explicit `limit` overrides this AND the free-tier pin.
SEC_FILING_RAG_MAX_PER_RUN=25
# How often the scheduled filings ingest runs (default 168 = weekly). Paid-tier operators
# draining the backlog set 24 so the capped per-run ingest happens daily.
SEC_FILING_INGEST_TTL_HOURS=168
# sec-ingest-worker-wiring (2026-07-18): the durable, checkpointed SEC backfill worker
# (src/lib/rag/sec-ingest-worker.ts over sec_ingest_jobs/sec_ingest_tasks). Default OFF; when on,
# the worker polls for 'running' jobs every 5s and drives claimed tasks through the
# discovered->...->complete checkpoint pipeline (EDGAR fetch, parse, chunk, Voyage/Pinecone embed —
# real provider cost). Jobs only exist after an explicit admin seed:
#   POST /api/admin/sec-ingest {action:"seed", offset?, limit?, ciks?}
# seeds one job per universe-manifest issuer (baseline: latest 10-K + latest 4 10-Qs); re-seeding is
# idempotent and NEVER re-drives dead-lettered documents. GET the same route for receipts.
SEC_INGEST_WORKER_ENABLED=off
WEB_SOURCE_SEC8K_RAG_LIMIT=16
WEB_SOURCE_SEC8K_FULL_BODY=off
WEB_SOURCE_SEC8K_FULL_BODY_LIMIT=5
RAG_EMBED_DISCLOSURES=off
# Owner enablement 2026-07-24: retrieval quality + guardrails ON by default (unset == on).
# Set any flag to off to disable. Multi-query/HyDE and full-body/rights gates stay OFF.
RAG_RUN_BUDGET_ENABLED=on
RAG_RUN_BUDGET_CEILING=5000
RAG_RETRIEVAL_TELEMETRY=on
RAG_RETRIEVAL_STAGE_TELEMETRY=on
RAG_CORPUS_WIDE_LEXICAL=on
RAG_PARENT_CONTEXT_EXPANSION=on
RAG_APPLY_DEFAULT_FLOORS=on
RAG_ADAPTIVE_RERANK=on
RAG_CITATION_STALENESS=on
# hyde-multiquery-retrieval (2026-07-05): default OFF, byte-identical retrieval when off.
# RAG_MULTIQUERY derives 2-4 evidence/sector-derived facet sub-queries (risk/guidance/litigation/
# supply-chain) per filings-pass candidate instead of one static query. RAG_HYDE additionally
# drafts 1-3 short hypothetical filing passages (HyDE) via one cheap LLM call and retrieves using
# those too; it only has an effect when RAG_MULTIQUERY is also on. RAG_HYDE_MODEL overrides the
# default cheap drafting model.
RAG_MULTIQUERY=off
RAG_HYDE=off
RAG_HYDE_MODEL=gpt-5.4-mini
# server-asof-filter (2026-07-06): push the point-in-time (as-of) constraint INTO the Pinecone query
# so topK is filled with ELIGIBLE (pre-asOf) candidates instead of being decimated by the post-fetch
# as-of drop (which leaves tiny/empty pools in backtests). Default ON (owner enablement 2026-07-24).
# FAIL-OPEN by default: un-epoch'd (un-backfilled) vectors still pass the server clause, so it's safe
# to turn on before running the backfill; the post-fetch guard stays the real leakage gate.
# VECTOR_ASOF_STRICT (also default OFF) additionally escalates the SERVER clause to FAIL-CLOSED
# (drop un-epoch'd server-side) for leakage-certified backtests, on top of its existing post-fetch
# strict undated-drop. New vectors get an `as_of_epoch_ms` metadata field automatically; run
# `npx tsx scripts/backfill-asof-epoch.ts` to add it to existing vectors (idempotent, safe to re-run).
VECTOR_ASOF_SERVER_FILTER=on
VECTOR_ASOF_STRICT=off
# Prefer RAG_CORPUS_WIDE_LEXICAL over the older HYBRID_RETRIEVAL path; keep hybrid OFF unless auditing.
HYBRID_RETRIEVAL=off
RAG_PERSIST_CANDIDATE_POOL=off
RAG_PERSIST_CANDIDATE_POOL_FULL=off
# Clean-text embed (R17). Default OFF. When ON, newly written vectors stamp embed_rev=2 (vs 1)
# so mixed populations stay distinguishable — do NOT purge rev-1 until a reindex receipt says so.
# Inventory: GET /api/admin/rag-coverage → dormantFeatures.currentEmbedRev / items.
VECTOR_EMBED_CLEAN_TEXT=off

# Retrieval-usefulness join + advisory ranking nudge (handoff 4.1, see
# src/lib/retrieval-usefulness.ts). The join itself (crediting each retrieved doc/kind with its
# matured outcome) always runs — it is pure bookkeeping. This only gates the BOUNDED advisory
# re-rank applied at retrieval time (±10% of the similarity score; unseen kinds get a neutral
# prior; any failure falls open to the incoming similarity order). Default on; set "off" to disable.
RETRIEVAL_USEFULNESS_WEIGHTING=on

# Experimental, disabled by default. Uses the unofficial community Python package
# `webull` for read-only quote enrichment only; never for orders or learning fills.
# Requires: pip install webull
WEBULL_UNOFFICIAL_ENABLED=off
WEBULL_UNOFFICIAL_PYTHON=python3

# --- Share market data with congress.trade (App A) ----------------------------------
# Forward company refs + daily closes + the S&P-500 series this app already fetches to
# congress.trade's idempotent import endpoint, so App A can avoid spending the shared FMP
# daily quota. Server-only; the token must NEVER reach the browser. See docs/congress-trade-share.md.
#
# Bearer token for App A's POST /api/admin/securities/import (its ADMIN_TOKEN or INGEST_TOKEN).
# Leave blank to disable all forwarding (default).
CONGRESS_TRADE_TOKEN=
# Base URL of App A (override for staging/local). Default: https://congress.trade
CONGRESS_TRADE_BASE_URL=https://congress.trade
# Master switch for AUTOMATIC forwarding: the after-scan hook (refs + fundamentals + analyst, from
# data the scan already fetched) AND the nightly batch (prices/volume + spx + insider + shortVolume).
# Requires CONGRESS_TRADE_TOKEN too. The admin route (/api/admin/congress-share) runs with the token
# alone, ignoring this flag. Default: off. (Fundamentals/analyst last-confirmed working 2026-06-14.)
CONGRESS_SHARE_ENABLED=off
# Separate switch for fundamentals/analyst in the outbound scan-hook push (requires App A PR #46).
# Without this, shareScanRefs skips the fundamentals/analyst arrays even when the share master
# switch (CONGRESS_SHARE_ENABLED) is on. Default: off.
CONGRESS_SHARE_FUNDAMENTALS_ENABLED=off

# --- API Usage Monitor (usage telemetry push + cost-aware feedback) -----------------
# Forward LLM / RAG / paid-provider usage + cost to the API Usage Monitor
# (usage.jays.services), so it can see providers it cannot poll (Anthropic, Voyage)
# plus real market-data call-volume. Server-only; the token must NEVER reach the browser.
# See docs/usage-monitor-integration.md.
#
# Push is a no-op (App B runs fully standalone) unless BOTH of these are set. An outage/misconfig
# only surfaces as a "usage-monitor" row on the admin connections-health page — it never blocks a run.
# Base URL of the monitor. Leave blank to disable the push (default).
USAGE_MONITOR_BASE_URL=https://usage.jays.services
# Bearer token for POST /api/ingest/usage (the monitor's USAGE_INGEST_TOKEN). Leave blank to disable.
USAGE_INGEST_TOKEN=
# Optional environment label stamped on pushed events (defaults to NODE_ENV).
USAGE_MONITOR_ENV=
# Cost-aware ENFORCEMENT (Phase 2). Default off: when off, an over-budget provider only fires an
# alert (Phase 1). When on, the strategy loop downgrades the LLM/red-team model to a cheaper tier —
# or skips the cycle if already cheapest — when the LLM provider is over budget (read from the
# monitor's GET /api/budget-status). Fail-open: a monitor outage never blocks a run.
USAGE_BUDGET_ENFORCE=off

# --- Trigger engine (improvement-program #2) ---
TRIGGER_ENGINE=on

# This app is public — indexable by search engines. Set to "off" to block crawlers
# (noindex + disallow-all robots.txt). Independent of LANDING_PAGE_ENABLED; prefer
# NEXT_PUBLIC_ALLOW_INDEXING for the marketing/SEO gate below.
PUBLIC_INDEXING=on

# --- Content-Security-Policy (default OFF; safe report-only canary) ----------------
# When CSP_ENABLED=on, middleware emits Content-Security-Policy-Report-Only with
# report-uri /api/csp-report (public collector, logs bounded summaries). Do NOT set
# CSP_REPORT_ONLY=off until report telemetry is clean — enforcing mode can break
# Next.js inline/eval bootstrap. Optional CSP_POLICY overrides the starter policy.
CSP_ENABLED=off
CSP_REPORT_ONLY=
CSP_POLICY=

# --- Macro history backfill --------------------------------------------------------
# How many YEARS of history the /api/admin/macro/load endpoint loads for each series
# (inflation, GDP, unemployment, Fed Funds rate, DXY, VIX, 10y-2y spread, etc.).
# Default 5. Each series is bulk-loaded by year, sourced from FRED (FRED_API_KEY above), NOT
# Alpha Vantage — this comment previously (incorrectly) attributed it to ALPHAVANTAGE_API_KEY.
MACRO_HISTORY_YEARS=5

# --- Massive REST API (second short-interest source) --------------------
# Optional. Wires Massive's REST API as a REAL second short-interest source: it cross-checks
# Yahoo's shortPercentOfFloat against Massive's FINRA short interest / free float and emits a
# `shortInterestDisagreement` evidence bulletin when they differ by more than
# SHORT_INTEREST_DISAGREEMENT_PCT_PT (default 5) percentage points. Inert unless MASSIVE_API_KEY
# is set; auth is `Authorization: Bearer <key>` against MASSIVE_REST_BASE_URL. This is the same
# Massive account/key as the flat-file S3 access below (its Secret Access Key doubles as the API key).
MASSIVE_API_KEY=
# Base URL for the Massive REST API. Default (verified against Massive's official REST docs, 2026-07):
MASSIVE_REST_BASE_URL=https://api.massive.com
# Operator OFF-switch for the extra 2 calls/symbol (short-interest + float). Default ON when a key is set.
MASSIVE_SHORT_INTEREST_ENABLED=
# Cache TTL (ms) for a Massive short-interest row. FINRA reports ~biweekly, so this is long. Default 12h.
MASSIVE_SHORT_INTEREST_TTL_MS=
# Percentage-point gap above which the primary-vs-Massive short read is flagged as a disagreement. Default 5.
SHORT_INTEREST_DISAGREEMENT_PCT_PT=

# --- QuiverQuant (congress/insider trades, gov contracts, lobbying, patents) --------
# Optional. Wires the five *Quiver carrier fields (congressTradesQuiver, insiderTradesQuiver,
# govContractsQuiver, lobbyingQuiver, patentsQuiver) — plumbed through types.ts/data-providers.ts
# since PR #1482 but never produced by any provider until this key-gated one (see
# src/lib/quiver-provider.ts). Inert (never registered, zero calls) unless QUIVER_API_KEY is set.
# Auth is `Authorization: Bearer <key>` against QuiverQuant's beta REST API
# (https://api.quiverquant.com/beta/). Long-TTL cached (>=24h; see quiver-provider.ts) — this is
# slow-moving data (congressional disclosures, quarterly lobbying/gov-contract filings).
QUIVER_API_KEY=
# Positive-result cache TTL (ms). Floored at 24h regardless of a lower override (this data doesn't
# move fast enough to justify a shorter cache). Default/floor 86400000 (24h).
QUIVER_CACHE_TTL_MS=
# Negative/partial-result cache TTL (ms) — a transient outage or single-dataset quota block retries
# the same day instead of sitting behind the 24h positive floor. Default 21600000 (6h).
QUIVER_NEGATIVE_CACHE_TTL_MS=
# Max symbols enriched per scan (each symbol costs 5 Quiver sub-fetches, so this is deliberately
# conservative — unlike the shared FMP_MAX_SYMBOLS knob). Unclamped override. Default 25.
QUIVER_MAX_SYMBOLS=

# --- Massive flat-file S3 ------------------------------------------------
# Massive is a standalone shared-S3 data lake (Parquet + Iceberg) containing years of
# split/dividend-adjusted EOD prices + fundamentals for the full US stock universe.
# Its Secret Access Key is your Massive API key. Used for the scalable broad-universe
# history backfill (admin congress-share {flatFile:true}).
MASSIVE_S3_ENDPOINT=
MASSIVE_BUCKET=
MASSIVE_ACCESS_KEY_ID=
MASSIVE_SECRET_ACCESS_KEY=
MASSIVE_S3_REGION=us-east-1
# How many years of history a flat-file backfill ({flatFile:true}) pulls per symbol. Default 5.
MASSIVE_FLATFILE_BACKFILL_YEARS=5

# Optional notifications.
WEBHOOK_URL=

# Multi-channel out-of-app alert delivery (src/lib/notify.ts) — used for price alerts AND the
# provider-tier watchdog ("subscription lapsed/changed" emails). Each channel is admin-gated here;
# the user picks which channels + targets (email address, etc.) in Settings → Notifications.
# EMAIL via Resend — set BOTH to enable the email channel:
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=alerts@jays.services
# Optional phone push (ntfy default, or pushover) + SMS (Twilio):
NOTIFY_PUSH_PROVIDER=ntfy
NOTIFY_NTFY_SERVER=https://ntfy.sh
PUSHOVER_APP_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_TIMEOUT_MS=5000

# Optional Sentry error/performance telemetry. Everything is OFF unless a DSN is set;
# all events are run through redactForTelemetry and sendDefaultPii is disabled.
# Server + edge runtime (sentry.server.config.ts / sentry.edge.config.ts):
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Scheduler dead-man's-switch: set to 1 (requires SENTRY_DSN) to send a Sentry Crons "ok"
# check-in to the 'scheduler-tick' monitor every 60s tick — alerts when the scheduler dies
# even though /api/health still returns 200.
SENTRY_CRONS_ENABLED=
# Browser runtime (instrumentation-client.ts). NEXT_PUBLIC_* values are inlined into the
# client bundle at build time, so set them before `next build`. The DSN is public/safe.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Session Replay is opt-in; when on it masks all text + blocks all media (financial data).
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=1
# Build-time source-map upload (de-minified prod stack traces). SENTRY_AUTH_TOKEN is a
# SECRET (not the DSN); upload only runs when it + org + project are all set. Org/project
# default to jays-services / agentic-trading in next.config.mjs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional Langfuse LLM observability. Default capture mode stores summaries/counts and
# redacted proposal metadata, not raw prompts, positions, account numbers, or API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=on
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_CAPTURE_IO=summary

# ── Auth / multi-user identity (Q3) ─────────────────────────────────────────
# The app derives a per-user id from a VERIFIED email; it never trusts a client-supplied userId.
# Identity comes from Auth.js sign-in. Cloudflare Tunnel may still expose the app, but
# Cloudflare Access email headers are no longer trusted as an app login source.
#
# CF_ACCESS_TRUST_EMAIL_HEADER: OFF by default — keep empty for new deployments. This is NOT a
# dead/ignored flag: middleware.ts still reads it. `cf-access-authenticated-user-email` is a
# PLAIN, spoofable HTTP header — if this origin is ever directly reachable (no Tunnel in front),
# anyone can forge it. So turning this flag on does NOT by itself trust the header: both
# CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD below must ALSO be set, and every request must carry a
# `Cf-Access-Jwt-Assertion` that verifies against the team's JWKS
# (https://<team>.cloudflareaccess.com/cdn-cgi/access/certs) with a matching audience before the
# header is trusted. Missing config, a missing assertion, or a failed verification (bad signature,
# wrong issuer/audience, expired) makes the header IGNORED — fail closed, never a partial/degraded
# trust of an unverified claim.
CF_ACCESS_TRUST_EMAIL_HEADER=
# Required (together with CF_ACCESS_AUD) for CF_ACCESS_TRUST_EMAIL_HEADER to actually arm. Your
# Cloudflare Access team domain — either the short team name (e.g. "acme", normalized to
# "acme.cloudflareaccess.com") or a full custom Access hostname.
CF_ACCESS_TEAM_DOMAIN=
# Required (together with CF_ACCESS_TEAM_DOMAIN). The protected Access application's Audience
# (AUD) tag — Cloudflare Zero Trust dashboard → Access → Applications → your app → Overview.
CF_ACCESS_AUD=
# The primary operator's email. Their account inherits the legacy "local" dataset (no migration needed).
PRIMARY_USER_EMAIL=mail@jays.services
# Optional: additional addresses for the SAME operator (comma-separated). Every alias maps to the one
# primary "local" account, so you can sign in with any of your emails (e.g. a Gmail + a custom-domain
# address) and land on the same data. They are auto-allowed and count as admin, like the primary.
PRIMARY_USER_EMAIL_ALIASES=
# Optional app-level allowlist (comma-separated).
# Behaviour depends on identity source:
#   - CF Access (CF_ACCESS_TRUST_EMAIL_HEADER=1): empty = defer to the CF Access allowlist.
#   - Auth.js (AUTH_SECRET set, no CF Access): empty = only PRIMARY_USER_EMAIL is admitted.
#     Any additional user (including any GitHub/Google account) MUST be listed here.
# Set for defense-in-depth or when you want to permit specific extra users.
ALLOWED_EMAILS=
# Optional admin-role allowlist (comma-separated). A primary/allowlisted email grants admin only
# when middleware marks its identity source as verified Cloudflare Access or Auth.js. Admin routes
# fail closed when neither a verified admin identity nor valid token is present in every environment.
ADMIN_USER_EMAILS=
# Legacy/static admin-operation token accepted as x-admin-token. Keep secret; leave blank to disable.
ADMIN_REINDEX_TOKEN=
# Dev/test fallback identity (only reachable when authConfigured=false; otherwise 401/redirect).
DEV_USER_ID=local
# Auth.js v5 sign-in — activates the Auth.js identity path when set.
# When AUTH_SECRET or CF_ACCESS_TRUST_EMAIL_HEADER=1 is set, auth is "configured" (armed):
# unauthenticated requests FAIL CLOSED (401 for /api/*, redirect to /login for pages).
# When NEITHER is set, the PRIMARY_USER_EMAIL fallback applies (local dev / tests).
#
# At least one OAuth provider (Google, GitHub, or Apple) must also be configured,
# or users will see the login page but have no way to sign in.
#
# Google OAuth:
#   1. Generate a secret:    openssl rand -base64 32
#   2. Create at least one OAuth client:
#      Google: https://console.cloud.google.com
#      - Application type: Web application
#      - Authorized redirect URI: https://<your-domain>/api/auth/callback/google
#   3. Set AUTH_SECRET + AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET below.
#
# GitHub OAuth (alternative or in addition to Google):
#   1. Create an OAuth App at https://github.com/settings/developers
#      - Homepage URL: https://<your-domain>
#      - Authorization callback URL: https://<your-domain>/api/auth/callback/github
#   2. Set AUTH_SECRET + AUTH_GITHUB_ID + AUTH_GITHUB_SECRET below.
#
# Apple Sign In:
#   1. Apple Developer Portal → Identifiers → register an App ID with Sign In with Apple.
#   2. Register a Services ID (this is AUTH_APPLE_ID, e.g. com.example.app.web).
#      - Return URL: https://<your-domain>/api/auth/callback/apple
#   3. Create a Sign In with Apple key; note the Key ID and download the .p8 file.
#   4. Generate the client-secret JWT (valid up to 6 months — must be regenerated):
#        npx auth add apple
#      This interactive CLI prompt asks for your Team ID, Key ID, and .p8 file path,
#      then writes AUTH_APPLE_ID and AUTH_APPLE_SECRET directly to your .env file.
#   ⚠  Apple only sends the user's email on the FIRST authorization. Subsequent
#      re-authorizations (after session expiry) will fail to produce an email and
#      sign-in will be rejected. Keep at least one other provider active as a fallback.
AUTH_SECRET=              # openssl rand -base64 32  — REQUIRED to arm auth
AUTH_GOOGLE_ID=           # Google OAuth 2.0 client ID
AUTH_GOOGLE_SECRET=       # Google OAuth 2.0 client secret
AUTH_GITHUB_ID=           # GitHub OAuth App client ID
AUTH_GITHUB_SECRET=       # GitHub OAuth App client secret
AUTH_APPLE_ID=            # Apple Services ID (e.g. com.example.app.web)
AUTH_APPLE_SECRET=        # Apple client-secret JWT (see setup instructions above)

# Execution-cost model for SIMULATED (paper/Test) fills — default OFF. When enabled, paper fills
# are booked at a cost-adjusted price (base slippage + half-spread + sqrt market-impact) so the
# learning loop is net-of-cost. Enable with the flag OR a positive base bps.
# PAPER_EXECUTION_COST_MODEL=on
# PAPER_EXECUTION_COST_BASE_BPS=5
# PAPER_EXECUTION_IMPACT_COEFF=10

# Starting simulated cash/buying power for the local Test simulator ("Test — Local Sim"). Default 100000.
TEST_SIM_STARTING_CASH=

# Litestream WAL replication (optional — see litestream.yml + docs/litestream.md)
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_REGION=us-east-1
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_ACCESS_KEY_ID=
LITESTREAM_S3_SECRET_ACCESS_KEY=

# --- Marketing / SEO (all optional; safe defaults keep the app private) ---
# Public base URL for canonical links, sitemap, and OpenGraph. Default: https://socratictrade.com
NEXT_PUBLIC_SITE_URL=
# Set to "true" ONLY to allow search engines to index the app. Default (unset) => every page is
# noindex/nofollow and robots.txt disallows all crawling.
NEXT_PUBLIC_ALLOW_INDEXING=
# Public marketing pages (/welcome, /how-it-works, /strategy + sitemap entries).
# Unset/empty = ON (product default since 2026-07-03). Set off/0/false/no to 404 those paths
# (private deploy). Indexing is still gated by NEXT_PUBLIC_ALLOW_INDEXING above.
LANDING_PAGE_ENABLED=

# --- Alpaca real-time price event-trigger producer (optional; default OFF) ---
# Streams Alpaca minute bars for active users' watched symbols and fires an immediate decision cycle
# (via the trigger engine) on a deterministic technical signal, instead of waiting for the next tick.
# Requires TRIGGER_ENGINE=1 (the trigger engine itself) and an Alpaca market-data key. No-op otherwise.
STREAMS_ALPACA_PRICE_EVENTS_ENABLED=
# Override the market-data WS endpoint (default derives from ALPACA_DATA_FEED: iex free / sip paid).
ALPACA_DATA_WS_URL=
# Max symbols to subscribe (free IEX caps concurrent subscriptions). Default 30; excess is dropped + logged.
ALPACA_PRICE_EVENT_MAX_SYMBOLS=30
# Signal thresholds + toggles (defaults shown).
ALPACA_PRICE_EVENT_MOVE_PCT=3
ALPACA_PRICE_EVENT_VOLUME_MULT=1.5
ALPACA_PRICE_EVENT_BREAKOUT=on
ALPACA_PRICE_EVENT_MOVE=on
ALPACA_PRICE_EVENT_VOLUME=on
# Note: true broker-held protective stops for LIVE Robinhood are a per-user POLICY flag
# (policy.robinhoodBrokerStops, default off — Settings/policy), not an env var. Verify the Robinhood
# MCP stop-order semantics against a live account before enabling; the synthetic monitor is the fallback.

# --- Autonomy boot persistence ---
# Safety interlock: on every restart, any account left "active" (autonomous) is reset to
# "halted" — preventing unattended trading after a crash, DB restore, or reboot. Set to 1
# to preserve the running state across restarts (recommended for dev only; think carefully
# before enabling in prod). The app audits every reset as "autonomy_halted_on_boot".
AUTONOMY_RESUME_ON_BOOT=

# Local-development safety gate for process-level background work. Production always starts the
# scheduler, crash-durable Usage Monitor replay, and individually enabled outbound streams. Every
# non-production runtime (including `next dev` and tests) keeps all three families off unless this
# is explicitly set to on/true/1/yes. Leave off for ordinary UI/API development.
DEV_BACKGROUND_WORKERS=off

# --- Ops diagnostic snapshot (remote agent / curl) ---
# Token-gated GET /api/ops/snapshot — strategy runs, per-account autonomy state, and recent
# audit rows (no OAuth session required). Pass as `x-ops-token` or `Authorization: Bearer`.
# Falls back to ADMIN_REINDEX_TOKEN only when OPS_DIAGNOSTIC_TOKEN is unset.
OPS_DIAGNOSTIC_TOKEN=

# --- Trading-liveness health signal (handoff 6b.7, see src/lib/trading-liveness.ts) ---
# Per active-autonomy account, how long since a strategy run actually COMPLETED and how many ran
# in a row failed. `degraded`-only — NEVER 503s /api/health. The public health route exposes only a
# minimal aggregate (counts + oldest age); full per-account detail is on the authed ops snapshot.
# Staleness is market-session-aware: a stale last-completed-run only degrades while the market is
# currently open (reuses market-calendar.ts's isMarketOpen — the scheduler's own source of truth),
# so the overnight/weekend baseline is never reported degraded.
# Minutes without a completed run before it's reported stale. Default 180.
TRADING_LIVENESS_STALE_MINUTES=
# Consecutive failed runs before it's reported degraded. Default 3.
TRADING_LIVENESS_MAX_CONSECUTIVE_FAILURES=

# --- Single-leader scheduler lease (improvement-program #3) ---
# Two app processes coordinate via a compare-and-swap lease in the settings table
# so only the leader runs the per-account tick body (synthetic-stop monitor + strategy runs)
# — preventing duplicate broker EXIT orders on multi-process deploys. Default ON, including
# unset/empty/whitespace values. Explicit false/off/0/no disables it for diagnostics.
SCHEDULER_SINGLE_LEADER=on
# Lease TTL in ms (how long a held lease stays valid without renewal before a standby may
# steal it). Default 90000 (1.5 ticks at 60s). Only relevant when SCHEDULER_SINGLE_LEADER is on.
SCHEDULER_LEASE_TTL_MS=90000

# --- Admin server metrics target ---
# Labels the remote infrastructure target in /admin/server. Set only when the configured Hetzner/
# Coolify credentials point to production; unset (or any other value) deliberately renders REMOTE.
SERVER_METRICS_TARGET_ENVIRONMENT=
