{
  "name": "socratic-trade-dashboard",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:secrets": "node scripts/infisical-run.mjs -- npm run dev",
    "dev:codex": "node scripts/codex-dev-server.mjs",
    "dev:clean": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true && next dev",
    "predev": "node scripts/predev-check.mjs",
    "build": "next build --webpack",
    "build:secrets": "node scripts/infisical-run.mjs -- npm run build",
    "start": "next start",
    "start:secrets": "node scripts/infisical-run.mjs -- npm run start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "gitleaks": "gitleaks detect --source . --verbose",
    "litestream:replicate": "bash scripts/run-litestream.sh",
    "litestream:restore": "bash scripts/litestream-restore.sh",
    "litestream:dry-run": "litestream databases -config litestream.yml",
    "eval:offline": "tsx scripts/eval/run-offline.ts",
    "eval:congress-score": "tsx scripts/eval/run-congress-score.ts",
    "eval:strategy-offline": "tsx scripts/eval/run-strategy-offline.ts",
    "eval:faithfulness": "tsx scripts/eval/run-faithfulness.ts",
    "eval:corpus-coverage": "tsx scripts/eval/corpus-coverage.ts",
    "eval:rag-census": "tsx scripts/eval/rag-census.ts",
    "eval:rag-production": "tsx scripts/eval/rag-production-eval.ts",
    "eval:pinecone-inference": "tsx scripts/eval/pinecone-inference-benchmark.ts",
    "eval:rag-shadow-benchmarks": "tsx scripts/eval/rag-shadow-benchmarks.ts",
    "eval:generate-universe": "tsx scripts/eval/generate-universe-manifest.ts",
    "eval:validate-universe": "tsx scripts/eval/validate-rag-universe.ts",
    "ops:snapshot": "bash scripts/fetch-prod-ops-snapshot.sh"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^3.1.3",
    "@datadog/browser-rum": "^7.13.0",
    "@jaywedgeworth22/congress-trading-shared": "github:jaywedgeworth22/congress-trading-shared#v2.7.0",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@pinecone-database/pinecone": "^8.2.0",
    "@sentry/nextjs": "^10.75.0",
    "@sentry/profiling-node": "10.75.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dd-trace": "^6.12.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.35.0",
    "motion": "^13.1.1",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-virtuoso": "^4.18.11",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "js-yaml": "^5.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "axios": "^1.18.0"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "@sentry/node-cpu-profiler@2.4.3": true,
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "sharp@0.34.5": true,
    "esbuild@0.23.1": true,
    "unrs-resolver@1.12.2": true,
    "github:jaywedgeworth22/congress-trading-shared": true
  }
}
